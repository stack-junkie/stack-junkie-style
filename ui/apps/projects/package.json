{
  "name": "stack-junkie-projects-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-ui": "node ../../scripts/prepare.mjs",
    "scan": "node scan.mjs",
    "predev": "npm run prepare-ui && npm run scan",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare-ui",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/scan.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
