{
  "name": "@stack-junkie/ui-web",
  "version": "3.0.0-preview.9",
  "private": true,
  "type": "module",
  "main": "./dist-library/stack-junkie-ui.js",
  "types": "./dist-types/web/src/library/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/web/src/library/index.d.ts",
      "import": "./dist-library/stack-junkie-ui.js"
    },
    "./styles.css": "./dist-library/styles.css",
    "./source": "./src/library/index.ts"
  },
  "files": [
    "dist-library",
    "dist-types"
  ],
  "scripts": {
    "predev": "node ../scripts/prepare.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node ../scripts/prepare.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild:library": "node ../scripts/prepare.mjs",
    "build:library": "vite build --config vite.library.config.ts && tsc -p tsconfig.library.json && node ../scripts/finish-web-library.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
