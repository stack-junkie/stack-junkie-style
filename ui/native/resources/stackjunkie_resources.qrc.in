<RCC><qresource prefix="/stackjunkie">
  <file alias="tokens.json">@STACKJUNKIE_SHARED@/tokens.json</file>
  <file alias="attribution.json">@STACKJUNKIE_SHARED@/attribution.json</file>
  <file alias="brand.json">@STACKJUNKIE_SHARED@/brand.json</file>
  <file alias="brand/sj-selected.png">@STACKJUNKIE_SHARED@/brand/sj-selected.png</file>
  <file alias="brand/sj-transparent-mask.png">@STACKJUNKIE_SHARED@/brand/sj-transparent-mask.png</file>
  <file alias="brand/sj-dark.png">@STACKJUNKIE_SHARED@/brand/sj-dark.png</file>
  <file alias="brand/sj-light.png">@STACKJUNKIE_SHARED@/brand/sj-light.png</file>
  <file alias="catalog.json">@STACKJUNKIE_SHARED@/catalog.json</file>
  <file alias="presets.json">@STACKJUNKIE_SHARED@/presets.json</file>
  <file alias="icons.svg">@STACKJUNKIE_SHARED@/icons.svg</file>
@STACKJUNKIE_INDICATOR_RESOURCES@
  <file alias="fonts/Manrope.ttf">@STACKJUNKIE_SHARED@/fonts/Manrope.ttf</file>
  <file alias="fonts/FiraCode.ttf">@STACKJUNKIE_SHARED@/fonts/FiraCode.ttf</file>
</qresource></RCC>
